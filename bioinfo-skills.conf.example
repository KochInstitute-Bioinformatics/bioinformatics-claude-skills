# Site settings for the bioinformatics Claude skills.
# Copy to ~/.claude/bioinfo-skills.conf and edit. Plain KEY=value lines, no quotes needed.
# Skills read this file at startup; any missing key is asked interactively.
# Leave a key empty to mean "not needed on my system".

# --- Scheduler ---
# One of: slurm, pbs, sge, lsf, local (no scheduler: plain bash scripts you run yourself). Empty = the skill asks.
# slurm and local are tested; pbs, sge and lsf are translated from the schedulers' documentation and not yet run on a real cluster.
SCHEDULER=
# PBS only: pbspro (default) or torque.
PBS_FLAVOR=
# Queue (SLURM: partition). Empty = no queue line or option. (SLURM_PARTITION and SLURM_PARTITION_ON_CLI from earlier
# versions are still read when QUEUE and QUEUE_ON_CLI are absent.)
QUEUE=
# Set to yes if your cluster ignores the queue line in the script header and needs the queue option on the submit
# command (for example "sbatch -p <partition> script.sh").
QUEUE_ON_CLI=no
# Caps on what the skills request (empty = no cap). MAX_TIME is [D-]HH:MM:SS. A job that must run longer than MAX_TIME
# (a Nextflow head job) is requested with MAX_TIME and resumed with -resume.
MAX_TIME=
MAX_MEM_GB=
MAX_CPUS=

# --- Software environment (shell lines placed in generated scripts) ---
# Run before `conda activate <env>` (e.g. `module load miniconda3` or `source ~/miniconda3/etc/profile.d/conda.sh`).
CONDA_SETUP=
# Make Singularity/Apptainer available (e.g. `module load singularity/3.10.4`). Empty if already on PATH.
SINGULARITY_LOAD=
# Make STAR and Salmon available for building genome indexes (nfcore-rnaseq-setup only).
RNASEQ_TOOLS_LOAD=

# --- Containers for the downstream skills ---
# Directory where .sif images are stored (must be readable from compute nodes).
SIF_DIR=
# Images (Docker URI). Defaults are public images by the skill author; use your own if you prefer
# (see containers/ for the Dockerfiles and the R packages each skill needs).
BULK_IMAGE=docker://yannvrb56/bulkrnaseq:latest
SC_IMAGE=docker://yannvrb56/r4_6_0_python3_singlecell_visium:latest
# Directory holding Azimuth reference packages (seurat-scrna-pipeline). Empty = skip Azimuth.
AZIMUTH_REFS_DIR=

# --- Reports ---
# Optional web-accessible prefix for results, e.g. https://myserver.org/results/. Empty = relative links.
WEB_URL_PREFIX=

# --- Bind mounts ---
# Comma-separated host directories always bound into containers (e.g. the root of a network filesystem that
# Singularity does not auto-bind). Empty = none; the skills then bind only the directories they use.
SINGULARITY_BIND=

# --- Only for running the skills' own test suites on a cluster (tests/ folders), not needed otherwise ---
# Shell init script that defines `module` inside batch jobs (e.g. /usr/share/lmod/lmod/init/bash), and MODULEPATH.
MODULE_INIT=
MODULEPATH=
